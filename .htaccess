RewriteEngine On

# 1. Standard index page setup
DirectoryIndex index.html

# 2. Redirect root domain (example.com) to default language (/eng/)
RewriteRule ^$ /eng/ [R=301,L]

# 3. Ensure trailing slashes on subfolders
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# 4. Skip existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Append .html relative to current folder path
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]