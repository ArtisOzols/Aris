#RewriteEngine On
#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteRule ^([^\.]+)$ $1.html [NC,L]

RewriteEngine On

# 1. Standard index page setup
DirectoryIndex index.html

# 2. Redirect root domain (example.com) to default language (/eng/)
RewriteRule ^$ /eng/ [R=301,L]

# 3. Ensure trailing slashes on subfolders so relative links/assets don't break
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]